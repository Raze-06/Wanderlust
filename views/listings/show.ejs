<% layout("/layouts/boilerplate") %>
<script>
  const listing = <%- JSON.stringify(list) %>;
</script>

<div class="container mt-3 px-3"> <!-- 🔴 CHANGED: added container and px-3 -->

  <!-- Title -->
  <div class="row">
    <div class="col-12 col-md-8 offset-md-2 mt-3"> <!-- 🔴 CHANGED: col-12 on mobile, offset only on md+ -->
      <h3><%= list.title %></h3>
    </div>
  </div>

  <!-- Listing Card -->
  <div class="row">
    <div class="col-12 col-md-8 offset-md-2 mb-3"> <!-- 🔴 CHANGED: full width on mobile -->
      <div class="card show-card listing-card">
        <img src="<%= list.image.url %>" class="card-img-top" alt="listing_image" style="max-height: 400px; object-fit: cover;" /> <!-- 🔴 NEW: limit image height -->
        <div class="card-body">
          <p>Owned by <b><i><%= list.owner.username %></i></b></p>
          <p class="card-text">
            <%= list.description %><br />
            &#8377; <%= list.price.toLocaleString("en-IN") %> <br />
            <%= list.location %> <br />
            <%= list.country %> <br />
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit / Delete Buttons -->
  <% if(currUser && list.owner._id.equals(currUser._id)) { %>
  <div class="row mb-3">
    <div class="col-12 col-md-8 offset-md-2 d-flex gap-2"> <!-- 🔴 CHANGED: full width + flexbox with gap -->
      <a href="/listings/<%= list.id %>/edit" class="btn btn-dark">Edit</a> <!-- 🔴 CHANGED: removed offset, cleaner -->
      <form action="/listings/<%= list.id %>?_method=DELETE" method="post">
        <button class="btn btn-dark">Delete</button> <!-- 🔴 CHANGED: removed offset-5 -->
      </form>
    </div>
  </div>
  <% } %>

  <!-- Reviews Section -->
  <div class="row">
    <div class="col-12 col-md-8 offset-md-2"> <!-- 🔴 CHANGED: full width on mobile -->

      <% if(currUser) { %>
      <hr />
      <h4>Leave a Review</h4>
      <form
        action="/listings/<%= list.id %>/reviews"
        method="post"
        class="needs-validation"
        novalidate
      >
        <div>
          <label for="rating" class="form-label mb-1">Rating</label> <!-- 🔴 CHANGED: fixed typo form=label → form-label -->
          <fieldset class="starability-grow">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>
        <div class="mt-2 mb-3">
          <label for="comment" class="form-label">Comment</label>
          <textarea
            name="review[comment]"
            id="comment"
            class="form-control"
            rows="5"
            required
          ></textarea>
          <div class="invalid-feedback">Please write a comment</div>
        </div>
        <button class="btn btn-outline-dark w-100 w-md-auto">Submit</button> <!-- 🔴 NEW: full width button on mobile -->
      </form>
      <% } %>

      <hr />

      <!-- All Reviews -->
      <% if(list.reviews.length > 0) { %>
      <h4>All Reviews</h4>
      <div class="row g-3"> <!-- 🔴 NEW: added g-3 for consistent gap -->
        <% for(review of list.reviews) { %>
        <div class="col-12 col-sm-6"> <!-- 🔴 CHANGED: full width on mobile, 2 cols on sm+ -->
          <div class="card h-100"> <!-- 🔴 NEW: h-100 for equal height cards -->
            <div class="card-body">
              <h5 class="card-title">@<%= review.author.username %></h5>
              <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
              <p class="card-text"><%= review.comment %></p>
              <form
                action="/listings/<%= list.id %>/reviews/<%= review.id %>?_method=DELETE"
                method="post"
                class="mb-2"
              >
                <button class="btn btn-sm btn-dark">Delete</button> <!-- 🔴 CHANGED: fixed btn-sm btn-dark order -->
              </form>
            </div>
          </div>
        </div>
        <% } %>
      </div>
      <% } %>

    </div>
  </div>

  <!-- Map Section -->
  <div class="row mt-4 mb-5"> <!-- 🔴 NEW: added mb-5 for bottom spacing -->
    <div class="col-12 col-md-8 offset-md-2"> <!-- 🔴 CHANGED: full width on mobile -->
      <h4>Where you'll be</h4>
      <div id="map" style="height: 300px; width: 100%; border-radius: 10px;"></div> <!-- 🔴 NEW: explicit height, full width, rounded -->
    </div>
  </div>

</div> <!-- 🔴 NEW: close container -->

<script src="/js/map.js"></script>