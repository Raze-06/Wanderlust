<% layout("/layouts/boilerplate") %>

<div class="row">
  <div class="col-8 offset-2">
    <h3 class="mt-3">Edit your listing</h3>
    <form
      action="/listings/<%= list.id %>?_method=PUT"
      method="post"
      class="needs-validation"
      novalidate
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          type="text"
          id="title"
          value="<%= list.title %>"
          name="title"
          class="form-control"
          required
        />
      </div>

      <div class="mb-3">
        <label for="desc" class="form-label">Description</label>
        <textarea
          name="description"
          id="desc"
          rows="3"
          cols="10"
          class="form-control"
          required
        >
<%= list.description %></textarea
        >
      </div>
      <div class="mb-3">
        <p>Current Image</p>
        <img src="<%= currentImageUrl %>" alt="listingImage" />
      </div>

      <div class="mb-3">
        <label for="img" class="form-label">Upload New Image </label>
        <input type="file" id="img" name="image" class="form-control" />
      </div>
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input
            type="number"
            id="price"
            value="<%= list.price %>"
            name="price"
            class="form-control"
            required
          />
        </div>

        <div class="mb-3 col-md-8">
          <label for="loc" class="form-label">Location</label>
          <input
            type="text"
            id="loc"
            value="<%= list.location %>"
            name="location"
            class="form-control"
            required
          />
        </div>
      </div>

      <div class="mb-3">
        <label for="nation" class="form-label">Country</label>
        <input
          type="text"
          id="nation"
          value="<%= list.country %>"
          name="country"
          class="form-control"
          required
        />
      </div>
      <button class="btn btn-dark edit-btn mt-3">Edit</button><br /><br />
    </form>
  </div>
</div>
